{
  "name": "k10-hub-backend",
  "version": "1.0.0",
  "description": "K10 Hub API server — backend for the UNIHIKER K10 learning platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:studio": "drizzle-kit studio --config=./drizzle.config.ts",
    "db:inspect": "tsx src/db/inspect.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@supabase/supabase-js": "^2.115.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.14.1",
    "typescript": "^5.4.5"
  }
}
